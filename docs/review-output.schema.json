{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "reportKind": {
          "type": "string",
          "const": "review"
        },
        "operation": {
          "type": "string",
          "enum": [
            "mark",
            "list",
            "reset"
          ]
        },
        "stateFile": {
          "type": "string"
        },
        "statePresence": {
          "type": "string",
          "enum": [
            "absent",
            "loaded",
            "written"
          ]
        },
        "matchingPolicy": {
          "type": "string",
          "const": "conservative-byte-content-v1"
        },
        "evidenceDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputCompleteness": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repositoryId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "contextId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "branch",
                  "staged",
                  "unstaged",
                  "all"
                ]
              },
              "snapshotId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "comparisonId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "hunkEvidenceId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "fileEvidenceId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pathBytes": {
                "type": "string",
                "minLength": 1
              },
              "contentFingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "unseen",
                  "reviewed",
                  "changed-since-reviewed"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "NO_ACKNOWLEDGMENT",
                  "CONTENT_UNCHANGED",
                  "BEFORE_REGION_CONTINUITY",
                  "AMBIGUOUS_HUNKS",
                  "INCOMPLETE_FILE",
                  "UNSUPPORTED_FILE"
                ]
              },
              "acknowledgment": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "snapshotId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "comparisonId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "hunkEvidenceId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "id",
                      "snapshotId",
                      "comparisonId",
                      "hunkEvidenceId"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "repositoryId",
              "contextId",
              "scope",
              "snapshotId",
              "comparisonId",
              "hunkEvidenceId",
              "fileEvidenceId",
              "path",
              "pathBytes",
              "contentFingerprint",
              "status",
              "reason",
              "acknowledgment"
            ],
            "additionalProperties": false
          }
        },
        "markedHunkEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "removedAcknowledgments": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "completeness": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "complete",
                "partial"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "state",
            "reasons"
          ],
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "const": "warning"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "severity",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "interpretation": {
          "type": "string",
          "const": "explicit-human-acknowledgment-not-correctness"
        }
      },
      "required": [
        "schemaVersion",
        "reportKind",
        "operation",
        "stateFile",
        "statePresence",
        "matchingPolicy",
        "evidenceDigest",
        "inputCompleteness",
        "rows",
        "markedHunkEvidenceIds",
        "removedAcknowledgments",
        "completeness",
        "diagnostics",
        "interpretation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "reportKind": {
          "type": "string",
          "const": "error"
        },
        "completeness": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "severity": {
                "type": "string",
                "const": "error"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "severity",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "reportKind",
        "completeness",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  ]
}
