{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "stateKind": {
      "type": "string",
      "const": "hunk-review"
    },
    "matchingPolicy": {
      "type": "string",
      "const": "conservative-byte-content-v1"
    },
    "acknowledgments": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contextId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "context": {
            "type": "object",
            "properties": {
              "repositoryId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "branch",
                  "staged",
                  "unstaged",
                  "all"
                ]
              },
              "head": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "attached",
                      "detached",
                      "unborn"
                    ]
                  },
                  "branch": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "detachedOid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "state",
                  "branch",
                  "detachedOid"
                ],
                "additionalProperties": false
              },
              "base": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "oid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "input",
                  "oid"
                ],
                "additionalProperties": false
              },
              "before": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "commit",
                      "index",
                      "working-tree",
                      "empty-tree"
                    ]
                  },
                  "commitOid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "commitOid"
                ],
                "additionalProperties": false
              },
              "comparisonOptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "configuration": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "attributes": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "repositoryId",
              "scope",
              "head",
              "base",
              "before",
              "comparisonOptions",
              "configuration",
              "attributes"
            ],
            "additionalProperties": false
          },
          "snapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "comparisonId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hunkEvidenceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fileEvidenceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "originalPathBytes": {
            "type": "string",
            "minLength": 1
          },
          "destinationPathBytes": {
            "type": "string",
            "minLength": 1
          },
          "fileStatus": {
            "type": "string",
            "enum": [
              "A",
              "M",
              "D",
              "R",
              "T"
            ]
          },
          "oldOid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "oldMode": {
            "type": "string",
            "pattern": "^[0-7]{6}$"
          },
          "beforeRegion": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "startLine": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "lineCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "startLine",
                  "lineCount"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "contentFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "beforeFingerprint": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "beforeUnique": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "contextId",
          "context",
          "snapshotId",
          "comparisonId",
          "hunkEvidenceId",
          "fileEvidenceId",
          "originalPathBytes",
          "destinationPathBytes",
          "fileStatus",
          "oldOid",
          "oldMode",
          "beforeRegion",
          "contentFingerprint",
          "beforeFingerprint",
          "beforeUnique"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "stateKind",
    "matchingPolicy",
    "acknowledgments"
  ],
  "additionalProperties": false
}
